# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchor to repo root so this Python-packaging rule does NOT swallow the CDK
# source dir agentcore/cdk/lib/ (which holds the hand-edited cdk-stack.ts).
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# uv
uv.lock
# NOTE: .python-version is intentionally NOT ignored — each module commits one to
# pin the local dev interpreter (3.11.14) so every participant's .venv matches.

# Environment files
.env
.env.local
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints

# pytest
.pytest_cache/

# Project specific
results/*
*/results/*
**/results/
temp/*
# NOTE: the per-module bundle Dockerfile is intentionally NOT ignored — it is the
# only thing that sets the deployed Python (the FROM image), so it must be committed
# for the deploy to be reproducible from a clean clone.
.bedrock_agentcore.yaml
dev_server.log
