# Module 0 — Infrastructure setup
# Copy to `.env` (gitignored) only if you need to override defaults.

# AWS region — auto-detected from the environment (AWS_REGION env var / instance
# metadata / AWS CLI config). Uncomment to override:
# AWS_REGION=us-west-2

# Optional: override the S3 bucket name. Default is
# student-analytics-agent-<your-account-id> (auto-derived).
# S3_BUCKET_NAME=

# AWS credentials come from your standard AWS config (aws configure / SSO / env).
