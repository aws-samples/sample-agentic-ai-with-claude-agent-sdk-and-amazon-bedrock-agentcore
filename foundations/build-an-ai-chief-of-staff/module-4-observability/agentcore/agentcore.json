{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "cosobserve",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "cosobserve"
  },
  "runtimes": [
    {
      "name": "cos",
      "build": "Container",
      "entrypoint": "agent_agentcore.py",
      "codeLocation": "chief_of_staff_agent/",
      "runtimeVersion": "PYTHON_3_11",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "instrumentation": { "enableOtel": true },
      "envVars": [
        { "name": "CLAUDE_CODE_USE_BEDROCK", "value": "1" },
        { "name": "ANTHROPIC_MODEL", "value": "global.anthropic.claude-sonnet-5-5" },
        { "name": "ANTHROPIC_SMALL_FAST_MODEL", "value": "global.anthropic.claude-haiku-5-5" }
      ]
    }
  ],
  "memories": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "harnesses": []
}