# Module 1 — Local Agent on Amazon Bedrock
# Copy this file to `.env` (which is gitignored) and adjust as needed.

# Use Amazon Bedrock as the model provider for the Claude Agent SDK.
CLAUDE_CODE_USE_BEDROCK=1

# Bedrock model IDs. The SDK picks these up automatically (no `model=` is set in code).
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-6-v1
ANTHROPIC_SMALL_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS region with Bedrock model access enabled.
AWS_REGION=us-west-2

# AWS credentials are read from your standard AWS config (aws configure / SSO / env).
# No need to put AWS keys here if `aws sts get-caller-identity` already works.
