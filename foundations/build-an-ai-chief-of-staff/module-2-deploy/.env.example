# Module 2 — Deploy to AgentCore Runtime
# Copy to `.env` (gitignored). Used for LOCAL testing (agentcore dev) and the
# invoke helper. The DEPLOYED agent gets its env from agentcore.json `envVars`.

# Use Amazon Bedrock as the model provider for the Claude Agent SDK.
CLAUDE_CODE_USE_BEDROCK=1

# Bedrock model IDs (no `model=` is hardcoded in the agent).
ANTHROPIC_MODEL=global.anthropic.claude-opus-4-6-v1
ANTHROPIC_SMALL_FAST_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS region with Bedrock + AgentCore access enabled.
AWS_REGION=us-west-2

# AWS credentials come from your standard AWS config (aws configure / SSO / env).
# To use a named AWS profile, uncomment the next line. A profile exported before
# you start Jupyter or your IDE takes precedence over this file.
# AWS_PROFILE=your-profile
